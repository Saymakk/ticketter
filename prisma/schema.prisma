// Prisma is used exclusively by the Healthy Life module (healthy-life.myworkspace.su).
// Ticketter itself talks to Supabase directly via @supabase/supabase-js — no other model needs this.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("HEALTHY_LIFE_DATABASE_URL")
  directUrl = env("HEALTHY_LIFE_DIRECT_URL")
}

model Profile {
  id               String             @id @default(cuid())
  userId           String?            @unique // Healthy Life Supabase auth.users.id
  name             String             @default("Пользователь")
  dailyCalorieGoal Int                @default(2000)
  targetWeightKg   Float?
  heightCm         Float?
  /** IANA timezone, e.g. Asia/Almaty — used for scheduled push reminders */
  timezone         String             @default("UTC")
  /** Master switch: send push reminders when subscriptions exist */
  pushEnabled      Boolean            @default(true)
  /** Optional daily weight log reminder "HH:mm" local time; null = off */
  weightReminderTime String?
  /** Optional meal log reminders as JSON array of "HH:mm" local times.
   * Empty array = off.
   */
  mealReminderTimesJson String          @default("[]")
  /** UI / push locale hint (en, ru, …) */
  preferredLocale  String             @default("en")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  meals            Meal[]
  weights          WeightEntry[]
  advice           Advice[]
  workouts         Workout[]
  medicationPlans  MedicationPlan[]
  medicationIntakes MedicationIntake[]
  aiRecords        AiRecord[]
  pushSubscriptions PushSubscription[]
  pushRemindersSent PushReminderSent[]
}

/** Web Push subscription for a device (PWA). */
model PushSubscription {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

/** Idempotency log so the same reminder slot is not pushed twice. */
model PushReminderSent {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /** medication | weight | meal */
  kind       String
  /** e.g. planId|2026-08-05|08:00 or weight|2026-08-05|08:00 */
  dedupeKey  String
  createdAt  DateTime @default(now())

  @@unique([profileId, kind, dedupeKey])
  @@index([profileId, createdAt])
}

model Meal {
  id             String   @id @default(cuid())
  profileId      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date           String // YYYY-MM-DD
  mealType       String   @default("snack") // breakfast | lunch | dinner | snack
  name           String
  description    String?
  calories       Float
  protein        Float?
  carbs          Float?
  fat            Float?
  portionGrams   Float?
  photoPath      String? // public URL in Supabase Storage
  aiDetectedName String?
  aiCalories     Float?
  aiConfidence   Float?
  aiRawResponse  String?  @db.Text
  aiRecordId     String?
  aiUsedFallback Boolean  @default(false)
  userCorrected  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([profileId, date])
  @@index([aiRecordId])
}

model WeightEntry {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  weightKg  Float
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, date])
  @@index([profileId, date])
}

model Advice {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  period       String // day | week | month
  periodKey    String // 2026-08-04__en | 2026-W32__ru | …
  title        String
  content      String   @db.Text
  summary      String?
  locale       String   @default("en")
  usedFallback Boolean  @default(false)
  aiRecordId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([profileId, period, periodKey])
  @@index([profileId, period])
  @@index([aiRecordId])
}

/**
 * Immutable per-user log of every AI response (food analysis, advice, …).
 * Current “latest advice” also lives in Advice; meals keep a snapshot + aiRecordId.
 */
model AiRecord {
  id             String   @id @default(cuid())
  profileId      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /** food_analysis | advice */
  kind           String
  locale         String?
  /** Short context: photo URL, period, etc. */
  inputSummary   String?  @db.Text
  /** Full model output as JSON text */
  outputJson     String   @db.Text
  usedFallback   Boolean  @default(false)
  fallbackReason String?
  /** Optional links back to domain rows */
  mealId         String?
  adviceId       String?
  createdAt      DateTime @default(now())

  @@index([profileId, kind, createdAt])
  @@index([profileId, createdAt])
}

model Workout {
  id             String   @id @default(cuid())
  profileId      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date           String // YYYY-MM-DD
  type           String // running | walking | cycling | strength | yoga | swimming | hiit | sports | other
  quantity       Float // minutes / km / sets / reps depending on unit
  unit           String   @default("minutes") // minutes | km | sets | reps
  name           String?
  note           String?
  caloriesBurned Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([profileId, date])
  @@index([profileId, type])
}

/** Recurring medication schedule (times of day + day periodicity). AI must never advise on these. */
model MedicationPlan {
  id           String             @id @default(cuid())
  profileId    String
  profile      Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name         String
  dosage       String?
  reason       String?
  /** JSON array of "HH:mm" local times, e.g. ["08:00","20:00"] */
  timesJson    String             @default("[]")
  /** daily | weekly | interval */
  recurrence   String             @default("daily")
  /** For weekly: JSON array of ISO weekdays 1=Mon … 7=Sun */
  weekdaysJson String             @default("[]")
  /** For interval: take every N days (N >= 1) */
  intervalDays Int                @default(1)
  /** YYYY-MM-DD anchor / start date for interval (and optional schedule start) */
  anchorDate   String?
  /** Optional pack photo URL */
  photoPath   String?
  active       Boolean            @default(true)
  note         String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  intakes      MedicationIntake[]

  @@index([profileId, active])
}

/** Actual medication intake logged for a day (optionally linked to a plan slot). */
model MedicationIntake {
  id            String          @id @default(cuid())
  profileId     String
  profile       Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  planId        String?
  plan          MedicationPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  date          String // YYYY-MM-DD
  name          String
  dosage        String?
  reason        String?
  photoPath     String?
  /** Planned slot "HH:mm" when taken against a schedule */
  scheduledTime String?
  /** Wall-clock time when the dose was logged "HH:mm" */
  takenTime     String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([profileId, date])
  @@index([planId, date])
}
