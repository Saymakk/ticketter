{
  "name": "ticketter-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:cloud": "node ./scripts/run-next-with-provider.mjs cloud dev",
    "dev:local": "node ./scripts/run-next-with-provider.mjs local dev",
    "dev:turbo": "next dev --turbopack",
    "build": "prisma generate && next build --webpack",
    "build:cloud": "node ./scripts/run-next-with-provider.mjs cloud build",
    "build:local": "node ./scripts/run-next-with-provider.mjs local build",
    "start": "next start",
    "start:cloud": "node ./scripts/run-next-with-provider.mjs cloud start",
    "start:local": "node ./scripts/run-next-with-provider.mjs local start",
    "supabase:sync-local-env": "node ./scripts/sync-local-supabase-env.mjs",
    "lint": "eslint",
    "deploy": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy.ps1",
    "postinstall": "prisma generate",
    "healthy-life:db:push": "prisma db push",
    "healthy-life:db:migrate": "prisma migrate deploy",
    "healthy-life:db:studio": "prisma studio",
    "bot": "tsx src/bot/healthy-life-bot.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "@types/web-push": "3.6.4",
    "@zxing/browser": "^0.1.5",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "file-saver": "^2.0.5",
    "grammy": "^1.45.1",
    "jszip": "^3.10.1",
    "next": "16.2.1",
    "next-pwa": "^5.6.0",
    "nodemailer": "^8.0.5",
    "openai": "^7.4.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.0",
    "sharp": "^0.34.5",
    "web-push": "3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
